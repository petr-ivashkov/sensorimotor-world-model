executable = run.sh
arguments = config_smoke.yaml
output = condor.smoke.$(Cluster).$(Process).out
error  = condor.smoke.$(Cluster).$(Process).err
log    = condor.smoke.$(Cluster).log
request_cpus   = 4
request_memory = 122880
request_gpus   = 1
# g164 currently advertises a GPU slot, but PyTorch cannot initialize CUDA there.
requirements   = !regexp("^g164([.]|$)", TARGET.Machine)

# Smoke test: 1 epoch sprite encoder on 2k samples. Writes results/smoke.
# Run this before sprite_decoder/smoke_decoder.sub.
queue 1
