# Stage 1 — frozen single-step reference (k_max=1 == train.py), 5 GPU jobs:
#   condor_submit_bid 100 train_ref.sub
executable = run.sh
arguments  = $(cfg)

output = condor.$(Cluster).$(Process).out
error  = condor.$(Cluster).$(Process).err
log    = condor.$(Cluster).log

request_cpus   = 4
request_memory = 122880
request_gpus   = 1

requirements = !regexp("^g164([.]|$)", TARGET.Machine)

queue cfg from (
  config_single_dot_kmax1.yaml
  config_2_independent_kmax1.yaml
  config_1_coupled_pair_kmax1.yaml
  config_1_dot_1_random_kmax1.yaml
  config_sprite_xyt_kmax1.yaml
)
