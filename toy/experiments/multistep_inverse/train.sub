executable = /bin/bash
arguments = -lc "experiments/multistep_inverse/run.sh"

output = condor.train.$(Cluster).$(Process).out
error  = condor.train.$(Cluster).$(Process).err
log    = condor.train.$(Cluster).log

request_cpus = 4
request_memory = 122880
request_gpus = 1

requirements = !regexp("^g164([.]|$)", TARGET.Machine)

queue 1