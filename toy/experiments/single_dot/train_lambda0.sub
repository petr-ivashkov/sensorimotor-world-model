executable = run.sh
arguments = config_lambda0.yaml
output = condor.lambda0.$(Cluster).$(Process).out
error = condor.lambda0.$(Cluster).$(Process).err
log = condor.lambda0.$(Cluster).log
request_cpus = 4
request_memory = 122880
request_gpus = 1
# g164 currently advertises a GPU slot, but PyTorch cannot initialize CUDA there.
requirements   = !regexp("^g164([.]|$)", TARGET.Machine)

queue 1
