executable = run.sh
cpus = 32
memory_mb = 163840

# Smoke test: 1 epoch, a handful of batches, one run per environment.
# Validates dataset loading, model build, the training step, and the
# final embedding dump on every environment -- without touching the real
# results tree (RUNS_ROOT is redirected to results_smoke).
#
# Run `python generate_configs.py` once before submitting, and
# `mkdir -p results_smoke` alongside it.
environment = "RUNS_ROOT=$ENV(PWD)/results_smoke"

arguments = $(run_name) trainer.max_epochs=1 +trainer.limit_train_batches=5 trainer.val_check_interval=5 trainer.limit_val_batches=2 wandb.enabled=false artifacts.embedding_subset_size=256

output = condor.smoke.$(Cluster).$(Process).$(run_name).out
error = condor.smoke.$(Cluster).$(Process).$(run_name).err
log = condor.smoke.$(Cluster).$(run_name).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

queue run_name from (
tworoom_inverse_lambda_0p1_seed0
reacher_inverse_lambda_1_seed0
pusht_inverse_lambda_30_seed0
cube_inverse_lambda_1_seed0
)
