executable = run.sh
cpus = 32
memory_mb = 163840

arguments = $(run_name)
output = condor.$(Cluster).$(Process).$(run_name).out
error = condor.$(Cluster).$(Process).$(run_name).err
log = condor.$(Cluster).$(run_name).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

# Training sweep: 4 environments x 3 methods x 5 seeds = 60 jobs.
# Run `python generate_configs.py` once before submitting.
queue run_name from (
tworoom_forward_only_seed0
tworoom_forward_only_seed1
tworoom_forward_only_seed2
tworoom_forward_only_seed3
tworoom_forward_only_seed4
tworoom_inverse_lambda_0p1_seed0
tworoom_inverse_lambda_0p1_seed1
tworoom_inverse_lambda_0p1_seed2
tworoom_inverse_lambda_0p1_seed3
tworoom_inverse_lambda_0p1_seed4
tworoom_sigreg_seed0
tworoom_sigreg_seed1
tworoom_sigreg_seed2
tworoom_sigreg_seed3
tworoom_sigreg_seed4
reacher_forward_only_seed0
reacher_forward_only_seed1
reacher_forward_only_seed2
reacher_forward_only_seed3
reacher_forward_only_seed4
reacher_inverse_lambda_1_seed0
