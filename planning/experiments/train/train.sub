reacher_inverse_lambda_1_seed3
reacher_inverse_lambda_1_seed4
reacher_sigreg_seed0
reacher_sigreg_seed1
reacher_sigreg_seed2
reacher_sigreg_seed3
reacher_sigreg_seed4
pusht_forward_only_seed0
pusht_forward_only_seed1
pusht_forward_only_seed2
pusht_forward_only_seed3
pusht_forward_only_seed4
