executable = run.sh
cpus = 32
memory_mb = 163840

# wm.history_size=3 smoke; writes results_smoke/smoke_h3 for planning_eval/smoke_h3.sub.
# LWM_ALLOW_OVERWRITE=1 because run.sh guards $RUNS_ROOT/$RUN_NAME while subdir= redirects output.
# Submit with: condor_submit_bid 100 smoke_h3.sub
environment = "RUNS_ROOT=$ENV(PWD)/results_smoke LWM_ALLOW_OVERWRITE=1"

arguments = cube_inverse_lambda_1_seed0 wm.history_size=3 subdir=smoke_h3 trainer.max_epochs=1 +trainer.limit_train_batches=5 trainer.val_check_interval=5 trainer.limit_val_batches=2 wandb.enabled=false artifacts.embedding_subset_size=256

output = condor.smoke_h3.$(Cluster).$(Process).out
error = condor.smoke_h3.$(Cluster).$(Process).err
log = condor.smoke_h3.$(Cluster).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

queue 1
