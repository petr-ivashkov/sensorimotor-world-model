executable = run.sh
cpus = 8
memory_mb = 49152

arguments = $(run_name)
output = condor.$(Cluster).$(Process).$(run_name).out
error = condor.$(Cluster).$(Process).$(run_name).err
log = condor.$(Cluster).$(run_name).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

# Planning eval for one environment's lambda sweep: one job per lambda (8).
# Reads the matching train_<env>/results/lambda_* checkpoints.
queue run_name from (
lambda_0
lambda_0p1
lambda_0p3
lambda_1
lambda_3
lambda_10
lambda_30
lambda_100
)
