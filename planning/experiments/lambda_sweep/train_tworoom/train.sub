executable = run.sh
cpus = 32
memory_mb = 163840

arguments = $(lambda_value) $(lambda_label)
output = condor.$(Cluster).$(Process).$(lambda_label).out
error = condor.$(Cluster).$(Process).$(lambda_label).err
log = condor.$(Cluster).$(lambda_label).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

# Inverse-loss (lambda) sweep for one environment: 8 jobs.
queue lambda_value,lambda_label from (
0 lambda_0
0.1 lambda_0p1
0.3 lambda_0p3
1 lambda_1
3 lambda_3
10 lambda_10
30 lambda_30
100 lambda_100
)
