executable = train_run.sh
cpus = 32
memory_mb = 163840

# Lambda sweep: 4 environments x 8 values x 5 seeds = 160 training jobs.
arguments = $(run_name)
output = logs/condor.train.$(Cluster).$(Process).$(run_name).out
error = logs/condor.train.$(Cluster).$(Process).$(run_name).err
log = logs/condor.train.$(Cluster).$(run_name).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

queue run_name from generated_configs/train_queue.txt
