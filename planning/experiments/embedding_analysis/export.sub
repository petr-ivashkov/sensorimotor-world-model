executable = run.sh
cpus = 8
memory_mb = 65536

arguments = $(env_name) $(method)
output = condor.$(Cluster).$(Process).$(env_name).$(method).out
error = condor.$(Cluster).$(Process).$(env_name).$(method).err
log = condor.$(Cluster).$(env_name).$(method).log
request_cpus = $(cpus)
request_memory = $(memory_mb)
request_gpus = 1
requirements = regexp("H100", TARGET.CUDADeviceName) && TARGET.CUDAGlobalMemoryMb >= 40000

# Embedding export: 4 environments x 3 methods x seed 0 = 12 jobs.
# Run `python generate_config.py --overwrite` once before submitting.
queue env_name,method from (
tworoom inverse
tworoom sigreg
tworoom forward_only
reacher inverse
reacher sigreg
reacher forward_only
pusht inverse
pusht sigreg
pusht forward_only
ogbcube inverse
ogbcube sigreg
ogbcube forward_only
)
